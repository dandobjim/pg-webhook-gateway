# Copy to .env (git-ignored) and adjust as needed.

# Local Postgres container (docker-compose.yml)
POSTGRES_USER=webhooks
POSTGRES_PASSWORD=webhooks
POSTGRES_DB=webhooks
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by the app and Alembic (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://webhooks:webhooks@localhost:5432/webhooks
